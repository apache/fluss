cmake_minimum_required(VERSION 3.22)

# Build the Rust archive and record its ordered native link requirements.
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E env "CARGO_TARGET_DIR=@CARGO_TARGET_DIR@"
        "@FLUSS_CARGO_EXECUTABLE@" rustc --manifest-path "@CARGO_MANIFEST@"
        @CARGO_BUILD_FLAGS@ --lib -- --print=native-static-libs
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
    ECHO_OUTPUT_VARIABLE ECHO_ERROR_VARIABLE)
file(WRITE "@CMAKE_CURRENT_BINARY_DIR@/cargo-build.log" "${output}\n${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cargo failed (${result}); see @CMAKE_CURRENT_BINARY_DIR@/cargo-build.log")
endif()
string(REGEX MATCH "native-static-libs: ([^\r\n]+)" native_match "${output}\n${error}")
if(NOT native_match)
    message(FATAL_ERROR "rustc did not report native-static-libs; cannot package link requirements")
endif()
set(native_libraries "${CMAKE_MATCH_1}")
file(WRITE "@CMAKE_CURRENT_BINARY_DIR@/native-link.rsp" "${native_libraries}\n")
