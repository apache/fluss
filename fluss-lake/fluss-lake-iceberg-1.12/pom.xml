<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.fluss</groupId>
        <artifactId>fluss-lake</artifactId>
        <version>1.1-SNAPSHOT</version>
    </parent>

    <artifactId>fluss-lake-iceberg-1.12</artifactId>
    <name>Apache Fluss : Lake : Iceberg 1.12</name>

    <!--
        The opt-in Iceberg 1.12 lake plugin. Iceberg 1.11+ is built for Java 17, so this module is
        compiled with a JDK 17 toolchain and tested on JDK 17, while Maven itself and the rest of the
        build stay on JDK 11. Fluss's own classes still target Java 11 bytecode: the plugin entry
        point can then be loaded on an older JVM and fail with a clear message instead of an
        UnsupportedClassVersionError.

        This module is a scaffold: the plugin itself is implemented in
        https://github.com/apache/fluss/issues/4592. Until then it is neither deployed nor part of
        the binary distribution.
    -->

    <properties>
        <iceberg.version>1.12.0</iceberg.version>
        <!-- TODO: deploy once the plugin is implemented (#4592). -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-lake-iceberg-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-api</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-common</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-core</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-data</artifactId>
            <version>${iceberg.version}</version>
            <exclusions>
                <!-- exclude dependency because of its GPLv2 license, see https://github.com/apache/flink/pull/15599#issuecomment-850241316 -->
                <exclusion>
                    <groupId>javax.annotation</groupId>
                    <artifactId>javax.annotation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-parquet</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-orc</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-bundled-guava</artifactId>
            <version>${iceberg.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-common</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- test dependency -->
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-test-utils</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Check against the Java 11 API, not just emit Java 11 class files. -->
                    <release>11</release>
                    <!-- Drop the root add-exports args: javac rejects them with release. -->
                    <compilerArgs combine.self="override">
                        <arg>-Xpkginfo:always</arg>
                    </compilerArgs>
                    <!-- compilation of main sources -->
                    <skipMain>${skip.on.java8}</skipMain>
                    <!-- compilation of test sources -->
                    <skip>${skip.on.java8}</skip>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${skip.on.java8}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                Compile, test and generate javadoc with a JDK 17+ toolchain. The JDK is discovered
                from ~/.m2/toolchains.xml, JAVA<version>_HOME variables and common install
                locations. Not active when Maven runs on Java 8, where this module is skipped.
            -->
            <id>jdk17-toolchain</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-toolchains-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>select-jdk-toolchain</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <version>[17,)</version>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
