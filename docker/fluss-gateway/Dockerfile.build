# Pin the compiler and glibc build environment used by the Linux convenience
# binary. Run this target on a native machine for the requested platform.
FROM rust:1.88-bookworm AS builder

ENV RUSTUP_TOOLCHAIN=1.88.0

WORKDIR /workspace
COPY fluss-rust/ fluss-rust/
COPY fluss-gateway/Cargo.toml \
     fluss-gateway/Cargo.lock \
     fluss-gateway/
COPY fluss-gateway/src/ fluss-gateway/src/
COPY fluss-gateway/tests/ fluss-gateway/tests/

RUN cargo build \
    --manifest-path fluss-gateway/Cargo.toml \
    --release \
    --locked \
    --bin fluss-gateway

FROM scratch AS artifact
COPY --from=builder \
    /workspace/fluss-gateway/target/release/fluss-gateway \
    /fluss-gateway
